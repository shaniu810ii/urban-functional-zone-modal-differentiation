# -*- coding: utf-8 -*-
"""
Cluster Doc2Vec community vectors and map urban functional zones.

Input files:
  outputs/doc2vec_seq3_dm0_32v_epochs10_midpoi.model
  data/community_units/beijing_community.shp
  data/study_area_boundary/beijing_central_area.shp

Output files:
  outputs/kmeans_dbi_scores.csv
  outputs/kmeans_dbi_curve.png
  outputs/community_doc2vec_kmeans.shp
  outputs/functional_zones_k6.png
"""

from pathlib import Path
import warnings

import gensim
import geopandas as gpd
import matplotlib.colors as mcolors
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.metrics import davies_bouldin_score

warnings.filterwarnings("ignore")

BASE_DIR = Path(".")
DATA_DIR = BASE_DIR / "data"
OUTPUT_DIR = BASE_DIR / "outputs"
PROJECT_CRS = "EPSG:4527"

MODEL_PATH = OUTPUT_DIR / "doc2vec_seq3_dm0_32v_epochs10_midpoi.model"
COMMUNITY_PATH = DATA_DIR / "community_units" / "beijing_community.shp"
BOUNDARY_PATH = DATA_DIR / "study_area_boundary" / "beijing_central_area.shp"
CLUSTER_SHP_PATH = OUTPUT_DIR / "community_doc2vec_kmeans.shp"


def compute_dbi(model, k_range=range(2, 15)) -> pd.DataFrame:
    vectors = model.dv[model.dv.index_to_key]
    scores = []
    for k in k_range:
        estimator = KMeans(n_clusters=k, random_state=20, n_init=20)
        labels = estimator.fit_predict(vectors)
        scores.append({"k": k, "davies_bouldin_index": davies_bouldin_score(vectors, labels)})
    return pd.DataFrame(scores)


def plot_dbi(scores: pd.DataFrame) -> None:
    fig, ax = plt.subplots(figsize=(8, 4.5))
    ax.plot(scores["k"], scores["davies_bouldin_index"], "o-", color="orange")
    ax.set_xlabel("k")
    ax.set_ylabel("Davies-Bouldin Index")
    ax.set_xticks(scores["k"])
    ax.set_title("Davies-Bouldin Index for k selection")
    fig.tight_layout()
    fig.savefig(OUTPUT_DIR / "kmeans_dbi_curve.png", dpi=300)
    plt.close(fig)


def cluster_vectors(model, k_list=(4, 5, 6, 7)) -> pd.DataFrame:
    vectors = model.dv[model.dv.index_to_key]
    cluster_df = pd.DataFrame({"SQDM": [int(x) for x in model.dv.index_to_key]})
    for k in k_list:
        estimator = KMeans(n_clusters=k, random_state=20, n_init=20)
        cluster_df[f"k_{k}"] = estimator.fit_predict(vectors)
    return cluster_df


def map_k6_clusters(cluster_gdf: gpd.GeoDataFrame) -> None:
    boundary = gpd.read_file(BOUNDARY_PATH).to_crs(PROJECT_CRS)
    colors = ["#66c2a5", "#fc8d62", "#ffd92f", "#e78ac3", "#a6d854", "#8da0cb"]

    fig, ax = plt.subplots(figsize=(10, 10))
    boundary.boundary.plot(ax=ax, color="black", linewidth=1.2)
    cluster_gdf.plot(
        column="k_6",
        categorical=True,
        cmap=mcolors.ListedColormap(colors),
        ax=ax,
        legend=True,
        edgecolor="white",
        linewidth=0.05,
    )
    ax.set_axis_off()
    fig.tight_layout()
    fig.savefig(OUTPUT_DIR / "functional_zones_k6.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    model = gensim.models.Doc2Vec.load(str(MODEL_PATH))
    scores = compute_dbi(model)
    scores.to_csv(OUTPUT_DIR / "kmeans_dbi_scores.csv", index=False)
    plot_dbi(scores)

    cluster_df = cluster_vectors(model)
    community = gpd.read_file(COMMUNITY_PATH).to_crs(PROJECT_CRS)
    if "SQDM" not in community.columns:
        community = community.reset_index(drop=True)
        community["SQDM"] = range(len(community))
    cluster_gdf = community.merge(cluster_df, on="SQDM", how="inner")
    cluster_gdf.to_file(CLUSTER_SHP_PATH)
    map_k6_clusters(cluster_gdf)


if __name__ == "__main__":
    main()
