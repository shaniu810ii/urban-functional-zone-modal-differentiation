# -*- coding: utf-8 -*-
"""
Optional POI preprocessing utility.

Input files:
  data/raw_poi_shp/*.shp

Output file:
  data/poi_shp/poi_cleaned.shp
"""

from pathlib import Path
import warnings

import geopandas as gpd
import pandas as pd

warnings.filterwarnings("ignore")

BASE_DIR = Path(".")
RAW_POI_DIR = BASE_DIR / "data" / "raw_poi_shp"
CLEAN_POI_DIR = BASE_DIR / "data" / "poi_shp"
OUTPUT_PATH = CLEAN_POI_DIR / "poi_cleaned.shp"

STUDY_DISTRICTS = {
    "Chaoyang District",
    "Haidian District",
    "Fengtai District",
    "Dongcheng District",
    "Xicheng District",
    "Shijingshan District",
}


def split_typename(value):
    if not isinstance(value, str):
        return None, None, None
    selected = value.split("|")[1] if "|" in value and len(value.split("|")) > 1 else value
    parts = selected.split(";")
    while len(parts) < 3:
        parts.append(None)
    return parts[0], parts[1], parts[2]


def clean_poi() -> gpd.GeoDataFrame:
    frames = []
    for shp_path in sorted(RAW_POI_DIR.glob("*.shp")):
        poi = gpd.read_file(shp_path)
        frames.append(poi)
    all_poi = pd.concat(frames, ignore_index=True)

    if "adname_en" in all_poi.columns:
        all_poi = all_poi[all_poi["adname_en"].isin(STUDY_DISTRICTS)]

    if "typename" in all_poi.columns:
        split_cols = all_poi["typename"].apply(split_typename)
        all_poi[["major_class", "mid_class", "sub_class"]] = pd.DataFrame(split_cols.tolist(), index=all_poi.index)

    excluded_major = {"Public facilities", "Indoor facilities", "Address information", "Transport facilities"}
    if "major_class" in all_poi.columns:
        all_poi = all_poi[~all_poi["major_class"].isin(excluded_major)]

    keep_cols = [col for col in ["major_class", "mid_class", "sub_class", "class", "geometry"] if col in all_poi.columns]
    return gpd.GeoDataFrame(all_poi[keep_cols], geometry="geometry", crs=getattr(all_poi, "crs", None))


def main() -> None:
    CLEAN_POI_DIR.mkdir(parents=True, exist_ok=True)
    cleaned = clean_poi()
    cleaned.to_file(OUTPUT_PATH)


if __name__ == "__main__":
    main()
