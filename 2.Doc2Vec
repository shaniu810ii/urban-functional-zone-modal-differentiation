# -*- coding: utf-8 -*-
"""
Train the Doc2Vec representation model for community-level functional-zone analysis.

Input files:
  outputs/random_id_mid_type_seq3.pkl
  outputs/road_random_points.shp
  data/community_units/beijing_community.shp

Output files:
  outputs/doc2vec_seq3_dm0_32v_epochs10_midpoi.model
  outputs/doc2vec_document_vectors.csv
"""

from pathlib import Path
import pickle
import warnings

import gensim
import geopandas as gpd
import pandas as pd

warnings.filterwarnings("ignore")

BASE_DIR = Path(".")
DATA_DIR = BASE_DIR / "data"
OUTPUT_DIR = BASE_DIR / "outputs"
PROJECT_CRS = "EPSG:4527"

SEQUENCE_PATH = OUTPUT_DIR / "random_id_mid_type_seq3.pkl"
RANDOM_POINTS_PATH = OUTPUT_DIR / "road_random_points.shp"
COMMUNITY_PATH = DATA_DIR / "community_units" / "beijing_community.shp"
MODEL_PATH = OUTPUT_DIR / "doc2vec_seq3_dm0_32v_epochs10_midpoi.model"
VECTOR_TABLE_PATH = OUTPUT_DIR / "doc2vec_document_vectors.csv"


def load_sequences(sequence_path: Path) -> pd.DataFrame:
    with sequence_path.open("rb") as f:
        return pickle.load(f)


def attach_community_id(sequence_df: pd.DataFrame) -> pd.DataFrame:
    community = gpd.read_file(COMMUNITY_PATH).to_crs(PROJECT_CRS)
    if "SQDM" not in community.columns:
        community = community.reset_index(drop=True)
        community["SQDM"] = range(len(community))

    random_points = gpd.read_file(RANDOM_POINTS_PATH).to_crs(PROJECT_CRS)
    point_to_community = gpd.sjoin(community[["SQDM", "geometry"]], random_points[["ID", "geometry"]], how="left", predicate="intersects")
    point_to_community = point_to_community[["SQDM", "ID"]].rename(columns={"SQDM": "community_id"})
    return sequence_df.merge(point_to_community, on="ID", how="inner")


def train_doc2vec(training_df: pd.DataFrame) -> gensim.models.doc2vec.Doc2Vec:
    corpus = training_df.apply(
        lambda row: gensim.models.doc2vec.TaggedDocument(row["type_seq"], [str(row["community_id"])]),
        axis=1,
    )
    model = gensim.models.doc2vec.Doc2Vec(dm=0, vector_size=32, workers=4, seed=20)
    model.build_vocab(corpus)
    model.train(corpus_iterable=corpus, total_examples=model.corpus_count, epochs=10)
    return model


def export_document_vectors(model: gensim.models.doc2vec.Doc2Vec) -> None:
    vectors = pd.DataFrame(model.dv[model.dv.index_to_key], index=model.dv.index_to_key)
    vectors.index.name = "SQDM"
    vectors.to_csv(VECTOR_TABLE_PATH)


def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    sequence_df = load_sequences(SEQUENCE_PATH)
    training_df = attach_community_id(sequence_df)
    model = train_doc2vec(training_df)
    model.save(str(MODEL_PATH))
    export_document_vectors(model)


if __name__ == "__main__":
    main()
