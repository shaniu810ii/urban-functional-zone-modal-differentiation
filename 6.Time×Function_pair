# -*- coding: utf-8 -*-
"""
Assign OD points to functional zones and draw OD heatmaps by mode and time period.

Input files:
  data/od/All_OD_od_distance.pkl
  outputs/community_doc2vec_kmeans.shp

Output files:
  outputs/all_od_function.pkl
  outputs/figures/figure7_od_matrix_heatmap.svg
"""

from pathlib import Path
import pickle
import warnings

import geopandas as gpd
import matplotlib.pyplot as plt
from matplotlib.colors import LinearSegmentedColormap
import numpy as np
import pandas as pd
import seaborn as sns
from shapely import wkt
from shapely.geometry import Point

warnings.filterwarnings("ignore")

BASE_DIR = Path(".")
DATA_DIR = BASE_DIR / "data"
OUTPUT_DIR = BASE_DIR / "outputs"
FIGURE_DIR = OUTPUT_DIR / "figures"
PROJECT_CRS = "EPSG:4527"

OD_PATH = DATA_DIR / "od" / "All_OD_od_distance.pkl"
FUNCTION_ZONE_PATH = OUTPUT_DIR / "community_doc2vec_kmeans.shp"
OD_WITH_FUNCTION_PATH = OUTPUT_DIR / "all_od_function.pkl"


def load_pickle(path: Path):
    with path.open("rb") as f:
        return pickle.load(f)


def time_period(shour):
    if 7 <= shour < 9:
        return "Morning Peak"
    if 11 <= shour < 14:
        return "Midday"
    if 14 <= shour < 17:
        return "Afternoon"
    if 17 <= shour < 20:
        return "Evening Peak"
    if 4 <= shour < 7:
        return "Early Morning"
    return "Night"


def parse_point(value):
    if isinstance(value, Point):
        return value
    if isinstance(value, str):
        try:
            geom = wkt.loads(value)
            return geom if isinstance(geom, Point) else None
        except Exception:
            return None
    return None


def spatial_join_with_random_boundary(points_gdf: gpd.GeoDataFrame, polygon_gdf: gpd.GeoDataFrame) -> pd.Series:
    joined = gpd.sjoin(points_gdf, polygon_gdf, how="left", predicate="within")
    unmatched = joined[joined["k_6"].isna()].index
    if len(unmatched) == 0:
        return joined["k_6"]

    boundary_points = points_gdf.loc[unmatched]
    boundary_join = gpd.sjoin(boundary_points, polygon_gdf, how="left", predicate="intersects")
    random_match = boundary_join.dropna(subset=["k_6"]).groupby(level=0).sample(n=1, random_state=20)
    joined.loc[random_match.index, "k_6"] = random_match["k_6"]
    return joined["k_6"]


def attach_function_zones(od: pd.DataFrame) -> pd.DataFrame:
    zones = gpd.read_file(FUNCTION_ZONE_PATH).to_crs(PROJECT_CRS)[["k_6", "geometry"]]
    od = od.copy()
    od["O_geom"] = od["O_point"].apply(parse_point)
    od["D_geom"] = od["D_point"].apply(parse_point)

    origin = gpd.GeoDataFrame(od[["O_geom"]], geometry="O_geom", crs=PROJECT_CRS)
    destination = gpd.GeoDataFrame(od[["D_geom"]], geometry="D_geom", crs=PROJECT_CRS)
    od["O_k6"] = spatial_join_with_random_boundary(origin, zones).round(0).astype("Int64")
    od["D_k6"] = spatial_join_with_random_boundary(destination, zones).round(0).astype("Int64")
    od = od.dropna(subset=["O_k6", "D_k6"])

    mode_map = {"taxi": "Taxi", "bike": "Bike", "GJ": "Bus", "DT": "Subway"}
    od["mode"] = od["mode"].replace(mode_map)
    od["O_peak"] = pd.to_numeric(od["Shour"], errors="coerce").apply(time_period)
    return od


def create_od_matrix(df: pd.DataFrame, o_col: str = "O_k6", d_col: str = "D_k6") -> pd.DataFrame:
    od_counts = df.groupby([o_col, d_col]).size().reset_index(name="count")
    return od_counts.pivot(index=o_col, columns=d_col, values="count").fillna(0)


def plot_combined_od_heatmaps(od: pd.DataFrame) -> None:
    modes = ["Bike", "Bus", "Subway", "Taxi"]
    periods = ["Morning Peak", "Midday", "Afternoon", "Evening Peak"]
    mode_colors = {"Bike": "green", "Bus": "#FFD700", "Subway": "red", "Taxi": "blue"}

    od_data = {}
    global_max = {}
    for mode in modes:
        od_data[mode] = {}
        mode_max = 0
        mode_data = od[od["mode"] == mode]
        for period in periods:
            matrix = create_od_matrix(mode_data[mode_data["O_peak"] == period])
            od_data[mode][period] = matrix
            if not matrix.empty:
                mode_max = max(mode_max, matrix.max().max())
        global_max[mode] = mode_max

    fig, axes = plt.subplots(len(modes), len(periods), figsize=(len(periods) * 6, len(modes) * 5), squeeze=False)
    for i, mode in enumerate(modes):
        cmap = LinearSegmentedColormap.from_list(f"{mode}_cmap", ["white", mode_colors[mode]])
        for j, period in enumerate(periods):
            ax = axes[i, j]
            matrix = od_data[mode][period]
            if matrix.empty or global_max[mode] == 0:
                ax.set_axis_off()
                continue
            values = matrix.values
            retained = np.eye(values.shape[0], dtype=bool)
            off_diag = [(r, c, values[r, c]) for r in range(values.shape[0]) for c in range(values.shape[1]) if r != c and values[r, c] > 0]
            for r, c, _ in sorted(off_diag, key=lambda x: x[2], reverse=True)[:30]:
                retained[r, c] = True
            sns.heatmap(matrix, annot=False, cmap=cmap, vmin=0, vmax=global_max[mode], mask=~retained, cbar=True, ax=ax)
            ax.set_title(f"{mode}-{period}")
            ax.set_xlabel("Destination")
            ax.set_ylabel("Origin")

    fig.tight_layout()
    fig.savefig(FIGURE_DIR / "figure7_od_matrix_heatmap.svg", dpi=300, bbox_inches="tight")
    plt.close(fig)


def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    FIGURE_DIR.mkdir(parents=True, exist_ok=True)
    od = load_pickle(OD_PATH)
    od_with_function = attach_function_zones(od)
    with OD_WITH_FUNCTION_PATH.open("wb") as f:
        pickle.dump(od_with_function, f)
    plot_combined_od_heatmaps(od_with_function)


if __name__ == "__main__":
    main()
