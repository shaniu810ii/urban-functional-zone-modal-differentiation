# -*- coding: utf-8 -*-
"""
Plot travel-distance and travel-duration distributions for four transport modes.

Input file:
  data/od/OD_four_modes_distance_class.csv

Output files:
  outputs/figures/figure4_travel_distance_distribution.png
  outputs/figures/figure5_travel_duration_distribution.png
"""

from pathlib import Path
import warnings

import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

BASE_DIR = Path(".")
DATA_DIR = BASE_DIR / "data"
OUTPUT_DIR = BASE_DIR / "outputs"
FIGURE_DIR = OUTPUT_DIR / "figures"
OD_PATH = DATA_DIR / "od" / "OD_four_modes_distance_class.csv"

MODE_ORDER = ["Bike", "Bus", "Subway", "Taxi"]
MODE_COLORS = {"Bike": "#2E8B57", "Bus": "#FFD700", "Subway": "#DC143C", "Taxi": "#1E90FF"}


def thousands_formatter(x, pos):
    return f"{int(x):,}" if x >= 1000 else f"{int(x)}"


def load_od() -> pd.DataFrame:
    od = pd.read_csv(OD_PATH)
    od["distance"] = pd.to_numeric(od["distance"], errors="coerce")
    if "duration" in od.columns:
        od["duration"] = pd.to_numeric(od["duration"], errors="coerce")
    return od.dropna(subset=["mode", "distance"])


def plot_distance_distribution(od: pd.DataFrame) -> None:
    data = od[od["distance"] > 250].copy()
    threshold = data["distance"].quantile(0.99)
    data = data[data["distance"] <= threshold].copy()

    bin_width = 250
    max_distance = int(np.ceil(threshold / bin_width) * bin_width)
    bins = list(range(0, max_distance + bin_width, bin_width))
    labels = [f"{i}-{i + bin_width}" for i in bins[:-1]]
    data["distance_bin"] = pd.cut(data["distance"], bins=bins, labels=labels, right=False)

    fig, axes = plt.subplots(2, 2, figsize=(16, 12), dpi=300)
    axes = axes.flatten()
    for idx, mode in enumerate(MODE_ORDER):
        ax1 = axes[idx]
        mode_data = data[data["mode"] == mode]
        bin_counts = mode_data["distance_bin"].value_counts().sort_index().reindex(labels, fill_value=0)
        x = np.arange(len(bin_counts))
        ax1.bar(x, bin_counts.values, color=MODE_COLORS[mode], alpha=0.7, width=0.6, edgecolor=MODE_COLORS[mode])
        ax1.set_title(mode, fontweight="bold")
        ax1.set_ylabel("Traffic Volume")
        ax1.yaxis.set_major_formatter(FuncFormatter(thousands_formatter))

        cumulative = bin_counts.cumsum() / max(bin_counts.sum(), 1) * 100
        ax2 = ax1.twinx()
        ax2.plot(x, cumulative.values, color="black", linewidth=2)
        ax2.set_ylabel("Cumulative Percentage (%)")
        ax2.set_ylim(0, 100)

        tick_step = max(1, len(labels) // 8)
        ax1.set_xticks(x[::tick_step])
        ax1.set_xticklabels(labels[::tick_step], rotation=45, ha="right")
        ax1.set_xlabel("Distance bin (m)")

    fig.tight_layout()
    fig.savefig(FIGURE_DIR / "figure4_travel_distance_distribution.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def plot_duration_distribution(od: pd.DataFrame) -> None:
    data = od[od["mode"].isin(["Bus", "Subway", "Taxi"])].dropna(subset=["duration"]).copy()
    parts = []
    for mode in ["Bus", "Subway", "Taxi"]:
        mode_data = data[data["mode"] == mode]
        parts.append(mode_data[mode_data["duration"] <= mode_data["duration"].quantile(0.99)])
    data = pd.concat(parts, ignore_index=True)

    bins = np.arange(0, 100, 3)
    x = bins[:-1] + 1.5
    colors = {"Bus": "#E8964C", "Subway": "#E16859", "Taxi": "#60BCDA"}

    fig, ax = plt.subplots(figsize=(10, 6), dpi=300)
    bottom = np.zeros(len(x))
    for mode in ["Subway", "Taxi", "Bus"]:
        binned = pd.cut(data[data["mode"] == mode]["duration"], bins=bins, right=False, include_lowest=True)
        percentages = binned.value_counts().sort_index() / max(len(binned), 1) * 100
        y = percentages.reindex(binned.cat.categories, fill_value=0).values
        ax.bar(x, y, width=2.7, bottom=bottom, color=colors[mode], edgecolor="white", linewidth=0.5, label=mode)
        bottom += y

    ax.set_xlim(0, 93)
    ax.set_ylim(0, 28)
    ax.set_xlabel("Travel Time (min)")
    ax.set_ylabel("Percentage (%)")
    ax.legend(frameon=False)
    fig.tight_layout()
    fig.savefig(FIGURE_DIR / "figure5_travel_duration_distribution.png", dpi=300, bbox_inches="tight")
    plt.close(fig)


def main() -> None:
    FIGURE_DIR.mkdir(parents=True, exist_ok=True)
    od = load_od()
    plot_distance_distribution(od)
    plot_duration_distribution(od)


if __name__ == "__main__":
    main()
